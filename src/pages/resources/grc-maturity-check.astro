---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';

const questions = [
  { area: 'Governance', q: 'Are GRC roles, committees and reporting lines defined and documented?', fix: 'Define a GRC framework: roles, committee charters and the three lines.', link: '/grc/' },
  { area: 'Obligations', q: 'Do you keep one register of the regulations, standards and contracts you must comply with?', fix: 'Build an obligation register and assign an owner to each obligation.', link: '/compliance-software/governance-risk-compliance/' },
  { area: 'Risk', q: 'Is there one enterprise risk register with a common scoring method, reviewed more than once a year?', fix: 'Standardise risk scoring and move to a living register with KRIs.', link: '/compliance-software/enterprise-risk-management/' },
  { area: 'Controls', q: 'Is each control mapped to every framework it satisfies, so evidence is collected once?', fix: 'Map controls across frameworks to stop answering the same question repeatedly.', link: '/grc/nca-ecc/' },
  { area: 'Internal audit', q: 'Are audit findings tracked to closure with owners and due dates, without manual chasing?', fix: 'Move findings and action follow-up onto a workflow with reminders.', link: '/compliance-software/internal-audit-management/' },
  { area: 'Cybersecurity', q: 'Can you show current evidence for your national cybersecurity framework and ISO 27001 within a day?', fix: 'Track security control evidence continuously rather than before each assessment.', link: '/compliance-software/cybersecurity-compliance/' },
  { area: 'Continuity', q: 'Has your BIA been updated and a continuity exercise run in the last 12 months?', fix: 'Refresh the BIA and schedule exercises with recorded results.', link: '/compliance-software/business-continuity-software/' },
  { area: 'Documents', q: 'Is there one controlled, current version of every policy and procedure, with approvals recorded?', fix: 'Introduce controlled documents with versioning and read-and-acknowledge.', link: '/compliance-software/document-management/' },
  { area: 'Reporting', q: 'Are board and committee GRC reports produced from live data rather than rebuilt by hand?', fix: 'Generate committee reports from a single system of record.', link: '/compliance-software/' },
  { area: 'Tools', q: 'Is most GRC work done in a dedicated system rather than spreadsheets and email?', fix: 'Consolidate onto one platform, starting with the weakest area above.', link: '/compliance-software/' },
];
---
<Base title="GRC Maturity Check: Free Self-Assessment" description="Ten questions on governance, risk, compliance, audit, cybersecurity and continuity. Get your GRC maturity score and the first areas to fix, free." crumbs={[{ name: 'Resources', href: '/resources/' }, { name: 'GRC maturity check' }]}>
  <PageHeader narrow eyebrow="Free self-assessment" title="How mature is your GRC programme?" lead="Ten questions, about three minutes. Your result appears instantly — no email needed to see it." />
  <section class="container-x max-w-3xl pb-14 pt-4">
    <form id="gm" class="mt-8 space-y-4">
      {questions.map((item, i) => (
        <fieldset class="card p-5" data-area={item.area} data-fix={item.fix} data-link={item.link}>
          <legend class="sr-only">{item.area}</legend>
          <p class="text-xs font-bold uppercase tracking-wider text-teal">{i + 1}. {item.area}</p>
          <p class="mt-1 font-semibold">{item.q}</p>
          <div class="mt-3 flex flex-wrap gap-2 text-sm">
            {[['2', 'Yes'], ['1', 'Partly'], ['0', 'No / not sure']].map(([v, l]) => (
              <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-ink/20 px-3 py-1.5 has-[:checked]:border-teal has-[:checked]:bg-teal/5">
                <input type="radio" name={`q${i}`} value={v} required class="accent-teal" /> {l}
              </label>
            ))}
          </div>
        </fieldset>
      ))}
      <button class="btn-primary w-full">See my result</button>
    </form>

    <div id="gm-result" class="mt-10 hidden scroll-mt-24">
      <div class="rounded-2xl bg-ink p-8 text-white">
        <p class="text-sm font-bold uppercase tracking-wider text-gold">GRC maturity</p>
        <p class="mt-2 text-5xl font-semibold"><span data-score></span><span class="text-2xl">/100</span></p>
        <p class="mt-3 text-lg font-bold" data-band></p>
        <p class="mt-2 text-white/75" data-advice></p>
      </div>
      <div class="card mt-4">
        <p class="font-semibold">Fix these first</p>
        <ul class="mt-3 space-y-3" data-gaps></ul>
      </div>
      <div class="mt-6 flex flex-wrap gap-3">
        <a data-cta class="btn-primary" href="/enquire/?route=grc-consulting">Discuss my result</a>
        <a href="/enquire/?route=compliance-software" class="btn-ghost">Get help choosing GRC software</a>
      </div>
      <p class="mt-4 text-xs text-ink-soft">A self-assessment to guide a conversation, not an audit or a compliance opinion.</p>
    </div>
  </section>
</Base>
<script>
  import { recordReadiness, track } from '../../scripts/lead';
  const form = document.getElementById('gm') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const sets = [...form.querySelectorAll<HTMLFieldSetElement>('fieldset[data-area]')];
    let total = 0;
    const gaps: { area: string; fix: string; link: string; v: number }[] = [];
    sets.forEach((f, i) => {
      const v = Number(fd.get(`q${i}`) ?? 0);
      total += v;
      if (v < 2) gaps.push({ area: f.dataset.area!, fix: f.dataset.fix!, link: f.dataset.link!, v });
    });
    gaps.sort((a, b) => a.v - b.v);
    const score = Math.round((total / (sets.length * 2)) * 100);
    const [band, advice] = score >= 75
      ? ['Managed', 'The framework works. Gains now come from automation, cross-framework mapping and live reporting.']
      : score >= 40
      ? ['Developing', 'The pieces exist but sit in silos. Connecting risk, controls and audit in one place is the next step.']
      : ['Initial', 'Start with governance and an obligation register, then move the weakest area onto a proper workflow.'];
    const res = document.getElementById('gm-result')!;
    res.querySelector('[data-score]')!.textContent = String(score);
    res.querySelector('[data-band]')!.textContent = band;
    res.querySelector('[data-advice]')!.textContent = advice;
    const list = res.querySelector('[data-gaps]')!;
    list.replaceChildren(...(gaps.length ? gaps.slice(0, 4) : [{ area: 'No major gaps self-reported', fix: 'Confirm with an independent review.', link: '/grc/', v: 2 }]).map((g) => {
      const li = document.createElement('li');
      li.innerHTML = `<p class="font-bold"></p><p class="text-sm text-ink-soft"></p><a class="text-sm font-bold text-teal hover:underline">Learn more →</a>`;
      li.children[0].textContent = g.area; li.children[1].textContent = g.fix; (li.children[2] as HTMLAnchorElement).href = g.link;
      return li;
    }));
    (res.querySelector('[data-cta]') as HTMLAnchorElement).href = `/enquire/?route=grc-consulting&score=${score}`;
    res.classList.remove('hidden');
    res.scrollIntoView({ behavior: 'smooth' });
    recordReadiness(score, 'GRC');
    track('grc_check_complete', { score });
  });
</script>
