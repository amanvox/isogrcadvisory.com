---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { categories, cohorts } from '../../data/training';

// Only confirmed cohorts are emitted; a client-side check hides any that pass their start date
// between builds, so expired dates never show.
const confirmed = cohorts.filter((c) => c.confirmed).sort((a, b) => a.start.localeCompare(b.start));
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title="Training: ISO Auditor & Professional Courses" description="ISO internal and lead auditor courses plus AI, Lean Six Sigma, PMP, risk, HSE and leadership training: public, virtual or in-house in the UAE and KSA." crumbs={[{ name: 'Training' }]}>
  <section class="hero">
    <div class="container-x py-14">
      <p class="eyebrow">Training</p>
      <h1 class="h1 mt-3 max-w-3xl">Auditor and professional training — public, virtual or at your premises</h1>
      <p class="lead-text mt-4 max-w-2xl">Choose a course and request current dates and fees. For five or more people from one organisation, an in-house programme is usually better value and can be tailored to your processes.</p>
      <div class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
        {categories.map((c) => <a href={`#${c.id}`} class="rounded-sm border border-ink/15 bg-white px-4 py-2 hover:border-teal">{c.name}</a>)}
      </div>
      <p class="mt-6 text-[15px]">Building a corporate academy or company-wide programme? <a href="/workforce/" class="font-semibold text-teal hover:underline">Workforce &amp; L&amp;D →</a></p>
    </div>
  </section>

  <section class="container-x py-12" id="upcoming">
    <h2 class="h2">Upcoming public cohorts</h2>
    {confirmed.length ? (
      <div class="mt-6 divide-y divide-line rounded-2xl border border-line" data-cohorts>
        {confirmed.map((c) => (
          <div class="flex flex-wrap items-center justify-between gap-3 p-5" data-start={c.start}>
            <div><p class="font-bold">{c.course}</p><p class="text-sm text-ink-soft">{fmt(c.start)} – {fmt(c.end)} · {c.location}</p></div>
            <a class="btn-ghost py-2" href={`/enquire/?route=iso-training&course=${encodeURIComponent(c.course)}`}>Reserve a seat</a>
          </div>
        ))}
      </div>
    ) : null}
    <p class="mt-4 text-ink-soft" data-no-cohorts class:list={[confirmed.length && 'hidden']}>New UAE, KSA and virtual dates are being confirmed. Request a course below and you’ll receive the next available dates and fees.</p>
  </section>

  {categories.map((cat) => (
    <section class="container-x py-8" id={cat.id}>
      <h2 class="text-xl font-semibold">{cat.name}</h2>
      <p class="mt-1 text-ink-soft">{cat.blurb}</p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {cat.courses.map((c) => (
          <a href={`/enquire/?route=${cat.route}&course=${encodeURIComponent(c.title)}`} class="card flex flex-col p-5 transition hover:border-teal">
            <p class="font-bold">{c.title}</p>
            <p class="mt-1 text-xs text-ink-soft">{[c.level, c.days && `${c.days} day${c.days > 1 ? 's' : ''}`].filter(Boolean).join(' · ')}</p>
            {c.credential && <p class="mt-1 text-xs font-semibold">{c.credential}</p>}
            <p class="mt-auto pt-3 text-sm font-bold text-teal">Get dates & fees →</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section class="container-x grid gap-10 py-14 lg:grid-cols-2">
    <div>
      <h2 class="h2">In-house programmes</h2>
      <p class="mt-3 leading-relaxed text-ink-soft">Bring the course to your team: examples drawn from your own processes, scheduling around operations, and delivery in English or Arabic where available. Typical in-house topics include ISO and IMS auditing, GRC and continuity, AI for business functions, Lean, HSE, customer experience, sales, leadership and office productivity tools.</p>
      <ul class="mt-5 space-y-2 text-[15px]">
        <li class="flex gap-2"><span class="text-teal">✓</span> Training needs analysis before the programme</li>
        <li class="flex gap-2"><span class="text-teal">✓</span> On-site in the UAE and Saudi Arabia, or virtual</li>
        <li class="flex gap-2"><span class="text-teal">✓</span> Assessments and completion reporting for HR</li>
      </ul>
    </div>
    <LeadForm route="other-training" heading="Request an in-house programme" />
  </section>
  <CtaBand title="Internal auditor or lead auditor?" text="Internal auditors audit their own organisation; lead auditors are trained to plan and lead audits, including of suppliers. Read the comparison before you book." href="/resources/internal-vs-lead-auditor/" label="Compare the two" />
</Base>
<script>
  const today = new Date().toISOString().slice(0, 10);
  const rows = document.querySelectorAll<HTMLElement>('[data-cohorts] [data-start]');
  let visible = 0;
  rows.forEach((r) => { if (r.dataset.start! < today) r.remove(); else visible++; });
  if (rows.length && !visible) {
    document.querySelector('[data-cohorts]')?.remove();
    document.querySelector('[data-no-cohorts]')?.classList.remove('hidden');
  }
</script>
