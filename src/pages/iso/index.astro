---
import Base from '../../layouts/Base.astro';
import CertExplainer from '../../components/CertExplainer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { launchedStandards, outcomeLabel } from '../../data/standards';

const families = [...new Set(launchedStandards.map((s) => s.family))];
---
<Base title="ISO Advisory & Certification Readiness, UAE & KSA" description="Find the right ISO standard for your tender, customer or regulator: ISO 9001, 27001, 22301, 42001, 14001, 45001 and more, in the UAE and Saudi Arabia." crumbs={[{ name: 'ISO Advisory' }]}>
  <section class="hero">
    <div class="container-x py-14">
      <p class="eyebrow">ISO Advisory</p>
      <h1 class="h1 mt-3 max-w-3xl">Which ISO standard do you actually need?</h1>
      <p class="lead-text mt-4 max-w-2xl">Most organisations arrive with a tender clause or customer request. Start from the problem, and we’ll map it to the right standard — or combination — and a realistic plan.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/resources/iso-standard-selection-guide/" class="btn-ghost">Read the selection guide</a>
        <a href="/enquire/?route=iso-consulting" class="btn-primary">Request a readiness review</a>
      </div>
    </div>
  </section>
  {families.map((f) => (
    <section class="container-x pt-14">
      <h2 class="text-xl font-semibold">{f}</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {launchedStandards.filter((s) => s.family === f).map((s) => (
          <a href={`/iso/${s.slug}/`} class="card transition hover:border-teal">
            <p class="text-sm font-bold text-teal">{s.code}</p>
            <p class="mt-1 font-semibold">{s.name}</p>
            <p class="mt-2 line-clamp-3 text-sm text-ink-soft">{s.summary}</p>
            <p class="mt-3 text-xs font-semibold text-ink-soft">{outcomeLabel[s.outcome]}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <CertExplainer />
  <CtaBand />
</Base>
