---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Thank you" description="Your enquiry has been received." noindex crumbs={[{ name: 'Thank you' }]}>
  <PageHeader narrow eyebrow="Enquiry received" title="Thanks — your enquiry is in" />
  <section class="container-x max-w-3xl py-14">
    <p class="lead-text">We’ll review it and get back to you about the next step. Your reference is <strong data-ref>—</strong>.</p>
    <p class="mt-3 text-sm text-ink-soft" data-fallback hidden>If a WhatsApp window opened, please press send so your enquiry reaches us.</p>
    <div class="mt-10 grid gap-3 text-left sm:grid-cols-2">
      <a href="/resources/iso-readiness-check/" class="card transition hover:border-teal"><p class="font-bold">Take the ISO readiness check</p><p class="mt-1 text-sm text-ink-soft">Useful to bring to our call.</p></a>
      <a href="/resources/iso-standard-selection-guide/" class="card transition hover:border-teal"><p class="font-bold">Read the standard selection guide</p><p class="mt-1 text-sm text-ink-soft">Which standard fits which requirement.</p></a>
    </div>
  </section>
</Base>
<script>
  try {
    const last = JSON.parse(sessionStorage.getItem('cd_last_lead') || 'null');
    if (last) {
      document.querySelector('[data-ref]')!.textContent = last.id;
      if (!last.sent) document.querySelector<HTMLElement>('[data-fallback]')!.hidden = false;
    }
  } catch {}
</script>
