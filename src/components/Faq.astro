---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
{items.length > 0 && (
  <section class="container-x py-14">
    <h2 class="h2">{title}</h2>
    <div class="mt-6 divide-y divide-line rounded-2xl border border-line">
      {items.map((f) => (
        <details class="group p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold">
            {f.q}<span class="text-teal transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 leading-relaxed text-ink-soft">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
