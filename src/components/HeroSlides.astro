---
// Full-bleed crossfading photo banner. Photos are decorative stock (see docs/IMAGE-CREDITS.md)
// and must never be captioned as clients, staff or projects.
const slides = [
  { file: 'training-workshop', pos: '70% 35%' },
  { file: 'presenting-results', pos: '60% 35%' },
  { file: 'riyadh-king-fahd-road', pos: '65% 45%' },
  { file: 'saudi-professional', pos: '35% 40%' },
  { file: 'dubai-downtown', pos: '60% 40%' },
];
---
<div class="hero-slides absolute inset-0 overflow-hidden" data-slides aria-hidden="true">
  {slides.map((s, i) => (
    <img
      src={`/images/hero/${s.file}.jpg`}
      srcset={`/images/hero/${s.file}-900.jpg 900w, /images/hero/${s.file}.jpg 1800w`}
      sizes="100vw"
      alt=""
      class:list={['slide', i === 0 && 'is-active']}
      style={`object-position:${s.pos}`}
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
      decoding="async"
    />
  ))}
  <div class="hero-shade"></div>
</div>
<button type="button" class="slides-toggle" data-slides-toggle aria-label="Pause background slideshow" aria-pressed="false">
  <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect class="i-pause" x="3" y="2" width="2.5" height="10" fill="currentColor" /><rect class="i-pause" x="8.5" y="2" width="2.5" height="10" fill="currentColor" /><path class="i-play" d="M4 2.5v9l7.5-4.5z" fill="currentColor" /></svg>
</button>

<style>
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.04); transition: opacity 1.6s ease, transform 9s linear; }
  .slide.is-active { opacity: 1; transform: scale(1.1); }
  .hero-shade { position: absolute; inset: 0; background:
    linear-gradient(90deg, rgba(6,26,46,.93) 0%, rgba(6,26,46,.82) 34%, rgba(6,26,46,.38) 62%, rgba(6,26,46,.12) 100%),
    linear-gradient(0deg, rgba(6,26,46,.92) 0%, rgba(6,26,46,0) 38%); }
  @media (max-width: 767px) { .hero-shade { background: linear-gradient(0deg, rgba(6,26,46,.97) 0%, rgba(6,26,46,.88) 45%, rgba(6,26,46,.5) 75%, rgba(6,26,46,.25) 100%); } }
  .slides-toggle { position: absolute; right: max(16px, env(safe-area-inset-right, 0px)); bottom: 18px; z-index: 2; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(255,255,255,.3); color: #fff; background: rgba(6,26,46,.45); transition: border-color .2s; }
  .slides-toggle:hover, .slides-toggle:focus-visible { border-color: #D9BC82; outline: none; }
  .slides-toggle .i-play { display: none; }
  .slides-toggle[aria-pressed="true"] .i-play { display: block; }
  .slides-toggle[aria-pressed="true"] .i-pause { display: none; }
  @media (prefers-reduced-motion: reduce) { .slide { transition: none; transform: none !important; } .slides-toggle { display: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-slides]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-slides-toggle]');
  if (root && toggle) {
    const slides = [...root.querySelectorAll<HTMLImageElement>('.slide')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer: number | undefined;
    const next = () => {
      slides[i].classList.remove('is-active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('is-active');
    };
    const play = () => { timer = window.setInterval(next, 7000); toggle.setAttribute('aria-pressed', 'false'); toggle.setAttribute('aria-label', 'Pause background slideshow'); };
    const pause = () => { window.clearInterval(timer); timer = undefined; toggle.setAttribute('aria-pressed', 'true'); toggle.setAttribute('aria-label', 'Play background slideshow'); };
    toggle.addEventListener('click', () => (timer ? pause() : play()));
    document.addEventListener('visibilitychange', () => { if (document.hidden && timer) { window.clearInterval(timer); timer = -1; } else if (!document.hidden && timer === -1) play(); });
    if (!reduce && slides.length > 1) play();
  }
</script>
