---
// Plan-Do-Check-Act ring: the improvement cycle shared by every ISO management system.
const cx = 220, cy = 220, r = 138, w = 30, gap = 2.2; // gap in degrees
const rad = (d: number) => ((d - 90) * Math.PI) / 180;
const pt = (rr: number, d: number) => [cx + rr * Math.cos(rad(d)), cy + rr * Math.sin(rad(d))];
function arc(a0: number, a1: number) {
  const ro = r + w / 2, ri = r - w / 2;
  const [x0, y0] = pt(ro, a0), [x1, y1] = pt(ro, a1), [x2, y2] = pt(ri, a1), [x3, y3] = pt(ri, a0);
  const large = a1 - a0 > 180 ? 1 : 0;
  return `M${x0} ${y0} A${ro} ${ro} 0 ${large} 1 ${x1} ${y1} L${x2} ${y2} A${ri} ${ri} 0 ${large} 0 ${x3} ${y3} Z`;
}
const segs = [
  { label: 'Plan', sub: 'Context, risks, objectives', fill: 'url(#g-plan)' },
  { label: 'Do', sub: 'Implement and operate', fill: 'url(#g-do)' },
  { label: 'Check', sub: 'Monitor, audit, review', fill: 'url(#g-check)' },
  { label: 'Act', sub: 'Correct and improve', fill: 'url(#g-act)' },
].map((s, i) => {
  const a0 = i * 90 + gap, a1 = (i + 1) * 90 - gap, mid = i * 90 + 45;
  const [lx, ly] = pt(r + w / 2 + 34, mid);
  return { ...s, d: arc(a0, a1), lx, ly, anchor: mid < 180 ? 'start' : 'end' };
});
const ticks = Array.from({ length: 72 }, (_, i) => {
  const d = i * 5, long = i % 18 === 0;
  const [x0, y0] = pt(r + w / 2 + 8, d), [x1, y1] = pt(r + w / 2 + (long ? 18 : 12), d);
  return { x0, y0, x1, y1, long };
});
---
<svg viewBox="-160 0 760 440" class="h-auto w-full max-w-[620px]" role="img" aria-labelledby="pdca-title">
  <title id="pdca-title">The Plan-Do-Check-Act cycle behind every ISO management system</title>
  <defs>
    <linearGradient id="g-plan" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6FCFC2" /><stop offset="1" stop-color="#2E9F92" /></linearGradient>
    <linearGradient id="g-do" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2E9F92" /><stop offset="1" stop-color="#1D5F6B" /></linearGradient>
    <linearGradient id="g-check" x1="1" y1="1" x2="0" y2="0"><stop offset="0" stop-color="#1D5F6B" /><stop offset="1" stop-color="#7F9BC7" /></linearGradient>
    <linearGradient id="g-act" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#7F9BC7" /><stop offset="1" stop-color="#D9BC82" /></linearGradient>
  </defs>
  <circle cx={cx} cy={cy} r={r - w / 2 - 14} fill="none" stroke="#FFFFFF" stroke-opacity="0.08" />
  {ticks.map((t) => <line x1={t.x0} y1={t.y0} x2={t.x1} y2={t.y1} stroke="#FFFFFF" stroke-opacity={t.long ? 0.5 : 0.16} stroke-width={t.long ? 1.4 : 1} />)}
  {segs.map((s) => <path d={s.d} fill={s.fill} />)}
  {segs.map((s) => (
    <g>
      <text x={s.lx} y={s.ly - 4} text-anchor={s.anchor} fill="#FFFFFF" font-size="19" font-weight="600" letter-spacing="0.3">{s.label}</text>
      <text x={s.lx} y={s.ly + 17} text-anchor={s.anchor} fill="#B4BDC9" font-size="13.5">{s.sub}</text>
    </g>
  ))}
  <text x={cx} y={cy - 10} text-anchor="middle" fill="#D9BC82" font-size="12.5" font-weight="600" letter-spacing="3">CONTINUAL</text>
  <text x={cx} y={cy + 10} text-anchor="middle" fill="#D9BC82" font-size="12.5" font-weight="600" letter-spacing="3">IMPROVEMENT</text>
  <text x={cx} y={cy + 36} text-anchor="middle" fill="#B4BDC9" font-size="12">ISO 9001 · 14001 · 27001 · 45001</text>
</svg>
