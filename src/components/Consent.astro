---
import { site } from '../data/site';
const ga4 = site.analytics.ga4Id;
---
{ga4 && (
  <div id="consent" class="fixed inset-x-3 bottom-20 z-50 hidden max-w-md rounded-xl border border-line bg-white p-4 text-sm shadow-xl md:bottom-4 md:left-4" role="dialog" aria-label="Analytics consent">
    <p>We’d like to use analytics cookies to understand which pages help visitors. No analytics run unless you accept. <a href="/privacy/" class="underline">Privacy notice</a></p>
    <div class="mt-3 flex gap-2">
      <button data-consent="granted" class="btn-primary py-2">Accept</button>
      <button data-consent="denied" class="btn-ghost py-2">Decline</button>
    </div>
  </div>
)}
<script define:vars={{ ga4 }}>
  if (ga4) {
    const KEY = 'cd_analytics_consent';
    let choice = null;
    try { choice = localStorage.getItem(KEY); } catch {}
    const load = () => {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('js', new Date());
      window.gtag('config', ga4, { anonymize_ip: true });
    };
    const box = document.getElementById('consent');
    if (choice === 'granted') load();
    else if (!choice && box) box.classList.remove('hidden');
    box?.querySelectorAll('[data-consent]').forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.getAttribute('data-consent');
        try { localStorage.setItem(KEY, v); } catch {}
        box.classList.add('hidden');
        if (v === 'granted') load();
      }),
    );
  }
</script>
